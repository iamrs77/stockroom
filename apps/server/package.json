{
  "name": "@stockroom/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "build": "node build.mjs",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@stockroom/shared": "^0.1.0",
    "bullmq": "^6.7.8",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "read-excel-file": "^9.3.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "^18.7.0-beta.19",
    "esbuild": "^0.28.2",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "vitest": "^5.1.1",
    "write-excel-file": "^4.1.1"
  }
