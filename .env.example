# Copy to .env to override the defaults. Nothing here is needed for local development:
# without a .env the server uses the local database that `npm run db` starts and Redis on localhost.

# Postgres connection string. Required in production.
# DATABASE_URL=postgres://postgres:postgres@localhost:5433/stockroom

# Redis connection string. Required in production. Redis 6.2 or later, with maxmemory-policy noeviction.
# REDIS_URL=redis://localhost:6379
# Prefix for every Redis key, so several environments can share one Redis database.
# REDIS_PREFIX=stockroom

# What this process runs: all (API and background workers), api, or worker.
# ROLE=all
# IMPORT_CONCURRENCY=2
# IMPORT_CHUNK_SIZE=1000

# Let webhooks reach localhost and private networks. Defaults to on in development; refused in production.
# WEBHOOKS_ALLOW_PRIVATE=true
# WEBHOOK_TIMEOUT_MS=10000
# WEBHOOK_RETRY_DELAY_MS=10000
# How often the outbox relay looks for events it wasn't told about.
# OUTBOX_POLL_MS=30000

# Bearer token for GET /metrics (Prometheus). Without it, /metrics is off in production.
# METRICS_TOKEN=

# PORT=3000
# LOG_LEVEL=info
# SESSION_TTL_DAYS=14
# DATABASE_POOL_MAX=10
