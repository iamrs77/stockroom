# Copy to .env to override the defaults. Nothing here is needed for local development:
# without a .env the server uses the local database that `npm run db` starts.

# Postgres connection string. Required in production.
# DATABASE_URL=postgres://postgres:postgres@localhost:5433/stockroom

# PORT=3000
# LOG_LEVEL=info
# SESSION_TTL_DAYS=14
# DATABASE_POOL_MAX=10
